/* ---- 6) Create native alerts (41074, 41075, 19406) and wire to jobs + operator ---- */

-- 41074
DECLARE @AlertName41074 SYSNAME;
SELECT @AlertName41074 = name FROM msdb.dbo.sysalerts WHERE message_id = 41074;
IF @AlertName41074 IS NULL
BEGIN
    EXEC msdb.dbo.sp_add_alert
         @name     = N'AG Replica Transition: 41074 (PRIMARY_PENDING)',
         @message_id = 41074,
         @severity   = 0,
         @enabled    = 1,
         @delay_between_responses = 600,
         @include_event_description_in = 1,
         @job_id = @jobId41074;
    SET @AlertName41074 = N'AG Replica Transition: 41074 (PRIMARY_PENDING)';
END
ELSE
BEGIN
    EXEC msdb.dbo.sp_update_alert
         @name     = @AlertName41074,
         @message_id = 41074,
         @severity   = 0,
         @enabled    = 1,
         @delay_between_responses = 600,
         @include_event_description_in = 1,
         @job_id = @jobId41074;
END
